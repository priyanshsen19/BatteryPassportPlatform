# Used by `pnpm --filter web dev` outside Docker. These are read on the server only;
# the browser talks to the Next.js server, never to the services or AWS directly.
AUTH_SERVICE_URL=http://localhost:4001
PASSPORT_SERVICE_URL=http://localhost:4002
DOCUMENT_SERVICE_URL=http://localhost:4003
# Optional: pinged on each visit so a sleeping notification service wakes up
NOTIFICATION_SERVICE_URL=http://localhost:4004
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
# Optional Google sign-in (see the root .env.example)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_APP_URL=http://localhost:3000
