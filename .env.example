# Copy to .env and adjust: `cp .env.example .env`
# Values below are for LOCAL development only. Never commit a .env file.

NODE_ENV=production
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Ports (host side)
# ---------------------------------------------------------------------------
AUTH_SERVICE_PORT=4001
PASSPORT_SERVICE_PORT=4002
DOCUMENT_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48   (must be at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# First administrator. Sign-ups without an access code are "user" accounts, so the auth service creates this
# account as admin at startup (or promotes it if it already exists; its password is never
# changed). Further roles are assigned by an admin on the User roles page.
BOOTSTRAP_ADMIN_EMAIL=admin@batterypassport.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional: anyone who enters this code on the sign-up page (or sends it as "accessCode" to
# POST /api/auth/register) becomes an admin. At least 8 characters; share it only with people
# who should be admins. Leave empty to disable admin sign-up.
ADMIN_ACCESS_CODE=

# Optional Google sign-in. Leave empty to disable. Create an OAuth client (type "Web
# application") in Google Cloud Console with the authorized redirect URI
# ${PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the web app, used for the OAuth redirect URI and password reset links
PUBLIC_APP_URL=http://localhost:3000
# Password reset links expire after this many minutes. The auth service emails them with the
# SMTP settings below; without SMTP_HOST the link is written to the auth-service log.
PASSWORD_RESET_TTL_MINUTES=30

# Ten sample passports added by the passport service at startup (only those not present yet)
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# MongoDB - one logical database per service
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=bpp
MONGO_ROOT_PASSWORD=replace-with-a-local-password
AUTH_MONGODB_URI=mongodb://bpp:replace-with-a-local-password@mongodb:27017/auth_db?authSource=admin
PASSPORT_MONGODB_URI=mongodb://bpp:replace-with-a-local-password@mongodb:27017/passport_db?authSource=admin
DOCUMENT_MONGODB_URI=mongodb://bpp:replace-with-a-local-password@mongodb:27017/document_db?authSource=admin

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=notification-service
# Hosted Kafka providers usually need TLS + SASL:
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# AWS S3 (LocalStack locally, AWS S3 in production)
# ---------------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_S3_BUCKET=battery-passport-documents
# LocalStack accepts any credentials; use an IAM user/role with bucket-scoped access for AWS.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Local only - leave both endpoints empty when using AWS S3.
AWS_S3_ENDPOINT=http://localstack:4566
AWS_S3_PUBLIC_ENDPOINT=http://localhost:4566
AWS_S3_FORCE_PATH_STYLE=true
DOWNLOAD_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Service-to-service URLs (Docker network names)
# ---------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:4001
PASSPORT_SERVICE_URL=http://passport-service:4002
DOCUMENT_SERVICE_URL=http://document-service:4003
# Optional: the web app pings it on each visit so a sleeping consumer wakes up
NOTIFICATION_SERVICE_URL=http://notification-service:4004

# Browser origins allowed to call the backend services directly
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional SMTP, used for notifications and password reset emails (logs only when SMTP_HOST is empty)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Battery Passport Platform <no-reply@battery-passport.local>
# Optional fallback: Brevo's HTTPS email API, used when SMTP is not set or fails (some hosts block
# outbound SMTP). Create an API key in Brevo and verify the SMTP_FROM address as a sender there.
BREVO_API_KEY=
# One or more recipients, separated by commas: ops@example.com, lead@example.com
NOTIFICATION_EMAIL_TO=
